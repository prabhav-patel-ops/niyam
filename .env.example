# External connections are deliberately empty. Copy this file to .env locally.
# Use an OpenAI-compatible /v1 endpoint. Model availability is provider-dependent.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional reference lookup. Requires a Tavily account/API key.
TAVILY_API_KEY=
# Optional canonical daily feed: see docs/DATA.md for its JSON contract.
DAILY_FEED_URL=
DAILY_FEED_API_KEY=

# Local defaults work without configuring anything below.
# NIYAM_DATA_DIR=/absolute/path/to/data
# NIYAM_STATE_DIR=/absolute/path/to/private/state
# NIYAM_ALLOWED_HOSTS=127.0.0.1,localhost
# Never commit .env, data, account state, sessions or API keys.

# Operator-owned deployment settings. Never expose these as user setup fields.
NIYAM_ENV=development
# Production: HTTPS origin without a trailing path, e.g. https://research.example.com
NIYAM_PUBLIC_URL=
# Production reverse-proxy hostname, matching NIYAM_PUBLIC_URL.
NIYAM_DOMAIN=
# Set ONLY after verifying split/bonus adjustments and dividend exclusion.
NIYAM_PRICE_BASIS=
# Supported value: split_bonus_adjusted_ex_dividend
NIYAM_REGISTRATION_OPEN=true
