# External connections are deliberately empty. Copy this file to .env locally.
# Use an OpenAI-compatible /v1 endpoint. Model availability is provider-dependent.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional reference lookup. Requires a Tavily account/API key.
TAVILY_API_KEY=
# Optional canonical daily feed: see docs/DATA.md for its JSON contract.
DAILY_FEED_URL=
DAILY_FEED_API_KEY=

# Local defaults work without configuring anything below.
# NIYAM_DATA_DIR=/absolute/path/to/data
# NIYAM_STATE_DIR=/absolute/path/to/private/state
# NIYAM_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://whood-yop.github.io
# NIYAM_ALLOWED_HOSTS=127.0.0.1,localhost
# Never commit .env, data, account state, sessions or API keys.
